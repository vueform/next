{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://vueform.com/schemas/api-extractor/contexts.json",
  "title": "Vueform extracted contexts",
  "description": "Contexts keyed by context name (.vueform/api/<source>/contexts.json): the creation params (`create<Name>Context` arguments) and what consuming the context returns (`use<Name>Context`).",
  "type": "object",
  "additionalProperties": {
    "type": "object",
    "required": ["description"],
    "additionalProperties": false,
    "properties": {
      "description": {
        "type": "string"
      },
      "loc": {
        "type": "string",
        "description": "Repo-relative `path:line` of the create<Name>Context (falling back to use<Name>Context) declaration.",
        "minLength": 1
      },
      "params": {
        "type": "object",
        "description": "Arguments of create<Name>Context.",
        "additionalProperties": {
          "type": "object",
          "required": ["type", "description"],
          "additionalProperties": false,
          "properties": {
            "type": {
              "type": "string",
              "minLength": 1
            },
            "description": {
              "type": "string"
            },
            "loc": {
              "type": "string",
              "description": "Repo-relative `path:line` of the parameter declaration.",
              "minLength": 1
            },
            "required": {
              "const": true
            }
          }
        }
      },
      "returns": {
        "type": "object",
        "description": "The return of use<Name>Context.",
        "required": ["type"],
        "additionalProperties": false,
        "properties": {
          "type": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string"
          },
          "loc": {
            "type": "string",
            "description": "Repo-relative `path:line` of the use<Name>Context declaration.",
            "minLength": 1
          }
        }
      }
    }
  }
}

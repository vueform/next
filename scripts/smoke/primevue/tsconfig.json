{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@vueform/core/blueprints/*": [
        "node_modules/@vueform/core/src/blueprints/*"
      ],
      "@vueform/core/components": [
        "node_modules/@vueform/core/src/components/index.ts"
      ],
      "@vueform/core/components/*/raw": [
        "node_modules/@vueform/core/src/components/*/index.ts"
      ],
      "@vueform/core/components/*": [
        "node_modules/@vueform/core/src/components/*/unstyled.ts"
      ],
      "@vueform/core": ["node_modules/@vueform/core/src/index.ts"],
      "@vueform/primevue/full": ["node_modules/@vueform/primevue/src/full.ts"],
      "@vueform/primevue/blueprints/*": [
        "node_modules/@vueform/primevue/src/blueprints/*"
      ],
      "@vueform/primevue/components": [
        "node_modules/@vueform/primevue/src/components/index.ts"
      ],
      "@vueform/primevue/components/*": [
        "node_modules/@vueform/primevue/src/components/*/unstyled.ts"
      ],
      "@vueform/primevue": ["node_modules/@vueform/primevue/src/index.ts"],
      "~/*": ["node_modules/@vueform/core/src/*"],
      "@/*": ["node_modules/@vueform/primevue/src/*"]
    }
  },
  "include": ["src"]
}

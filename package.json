{
  "private": true,
  "type": "module",
  "scripts": {
    "api": "tsx scripts/api.ts",
    "api:missing": "tsx scripts/api-missing.ts",
    "attw": "tsx scripts/attw.ts",
    "bench": "pnpm --filter @vueform/benchmark run bench",
    "bench:charts": "pnpm --filter @vueform/benchmark run charts",
    "build": "tsx scripts/build.ts",
    "check": "tsx scripts/check.ts",
    "claim": "tsx scripts/claim.ts",
    "clean": "tsx scripts/clean.ts",
    "dev": "pnpm pg",
    "docs:build": "vpr :docs:build",
    "docs:dev": "pnpm --filter @vueform/docs run dev",
    "docs:gen": "vpr :docs:gen",
    "docs:pre": "pnpm --filter @vueform/docs run pre",
    "docs:preview": "pnpm --filter @vueform/docs run preview",
    "eslint": "vpr :eslint",
    "fix": "tsx scripts/fix.ts",
    "fmt": "vp fmt",
    "lint": "vpr :lint",
    "ls-lint": "vpr :ls-lint",
    "manifests": "vpr :manifests",
    "oxlint": "vpr :oxlint",
    "pack": "tsx scripts/pack.ts",
    "pg": "tsx scripts/playground/dev.ts",
    "pg:build": "tsx scripts/playground/build.ts",
    "pg:down": "tsx scripts/playground/down.ts",
    "pg:pre": "tsx scripts/playground/pre.ts",
    "pg:preview": "tsx scripts/playground/preview.ts",
    "pg:re": "tsx scripts/playground/re.ts",
    "pg:up": "tsx scripts/playground/up.ts",
    "quick": "vpr :quick",
    "re": "pnpm clean && pnpm install",
    "registry": "tsx scripts/registry.ts",
    "release": "tsx scripts/release.ts",
    "size": "tsx scripts/size.ts",
    "size:report": "tsx scripts/size.ts --report",
    "stylelint": "vpr :stylelint",
    "test": "tsx scripts/test.ts",
    "test-dts": "tsx scripts/test-dts.ts",
    "test-smoke": "tsx scripts/test-smoke.ts",
    "test-smoke-types": "tsx scripts/test-smoke-types.ts",
    "test-visual": "tsx scripts/test-visual.ts",
    "typecheck": "vpr :typecheck"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "catalog:",
    "@commitlint/cli": "catalog:",
    "@commitlint/config-conventional": "catalog:",
    "@commitlint/types": "catalog:",
    "@ls-lint/ls-lint": "catalog:",
    "@types/node": "catalog:",
    "@types/semver": "catalog:",
    "@typescript-eslint/parser": "catalog:",
    "@vscode/web-custom-data": "catalog:",
    "@vue/tsconfig": "catalog:",
    "@vueform/core": "workspace:*",
    "@vueform/devtools": "workspace:*",
    "@vueform/dompurify": "workspace:*",
    "@vueform/expr-eval": "workspace:*",
    "@vueform/tsconfig": "workspace:*",
    "@vueform/ui": "workspace:*",
    "@vueform/utils": "workspace:*",
    "ajv": "catalog:",
    "conventional-changelog-cli": "catalog:",
    "conventional-changelog-conventionalcommits": "catalog:",
    "conventional-recommended-bump": "catalog:",
    "eslint": "catalog:",
    "eslint-config-prettier": "catalog:",
    "eslint-plugin-vue": "catalog:",
    "husky": "catalog:",
    "lint-staged": "catalog:",
    "publint": "catalog:",
    "semver": "catalog:",
    "stylelint": "catalog:",
    "stylelint-config-recess-order": "catalog:",
    "stylelint-config-standard-scss": "catalog:",
    "stylelint-order": "catalog:",
    "taze": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:",
    "vue": "catalog:",
    "vue-eslint-parser": "catalog:",
    "vue-tsc": "catalog:"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts,mts,cts}": [
      "pnpm vp lint --fix --fix-suggestions",
      "pnpm vp fmt"
    ],
    "*.vue": [
      "pnpm vp lint --fix --fix-suggestions",
      "pnpm eslint --fix",
      "pnpm vp fmt"
    ],
    "*.scss": [
      "pnpm stylelint --fix",
      "pnpm vp fmt"
    ],
    "*.{json,yml,yaml}": [
      "pnpm vp fmt"
    ]
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@10.20.0",
  "pnpm": {
    "overrides": {
      "vue": "catalog:"
    }
  }
}

{
  "private": true,
  "scripts": {
    "build": "vpr :build",
    "check": "vpr :check",
    "fix": "vpr :fix",
    "fmt": "vp fmt",
    "lint": "vpr :lint",
    "quick": "vpr :quick",
    "pack": "vpr :pack",
    "test": "tsx scripts/test.ts",
    "test-dts": "tsx scripts/test-dts.ts",
    "test-smoke": "tsx scripts/test-smoke.ts",
    "test-visual": "tsx scripts/test-visual.ts",
    "typecheck": "vpr :typecheck"
  },
  "devDependencies": {
    "@commitlint/cli": "catalog:",
    "@commitlint/config-conventional": "catalog:",
    "@types/node": "catalog:",
    "@typescript-eslint/parser": "catalog:",
    "@vue/tsconfig": "catalog:",
    "@vueform/core": "workspace:*",
    "@vueform/dompurify": "workspace:*",
    "@vueform/expr-eval": "workspace:*",
    "@vueform/tsconfig": "workspace:*",
    "@vueform/ui": "workspace:*",
    "@vueform/utils": "workspace:*",
    "ajv": "catalog:",
    "eslint": "catalog:",
    "eslint-config-prettier": "catalog:",
    "eslint-plugin-vue": "catalog:",
    "husky": "catalog:",
    "lint-staged": "catalog:",
    "publint": "catalog:",
    "stylelint": "catalog:",
    "stylelint-config-recess-order": "catalog:",
    "stylelint-config-standard-scss": "catalog:",
    "stylelint-order": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:",
    "vue": "catalog:",
    "vue-eslint-parser": "catalog:",
    "vue-tsc": "catalog:"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts,mts,cts}": [
      "pnpm vp lint --fix --fix-suggestions",
      "pnpm vp fmt"
    ],
    "*.vue": [
      "pnpm vp lint --fix --fix-suggestions",
      "pnpm eslint --fix",
      "pnpm vp fmt"
    ],
    "*.scss": [
      "pnpm stylelint --fix",
      "pnpm vp fmt"
    ],
    "*.{json,yml,yaml}": [
      "pnpm vp fmt"
    ]
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@10.20.0",
  "pnpm": {
    "overrides": {
      "vue": "catalog:"
    }
  }
}

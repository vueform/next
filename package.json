{
  "private": true,
  "packageManager": "pnpm@10.20.0",
  "scripts": {
    "pg": "node playground/scripts/dev.mjs",
    "pg:up": "node playground/scripts/up.mjs",
    "pg:down": "node playground/scripts/down.mjs",
    "pg:build": "node playground/scripts/build.mjs",
    "pg:pre": "node playground/scripts/pre.mjs",
    "pg:re": "node playground/scripts/re.mjs",
    "bench": "pnpm --filter @vueform/metrics run bench",
    "bench:charts": "pnpm --filter @vueform/metrics run bench:charts",
    "bench:report": "pnpm --filter @vueform/metrics run bench:report",
    "size": "pnpm --filter @vueform/metrics run size",
    "size:report": "pnpm --filter @vueform/metrics run size:report",
    "scrape": "pnpm --filter @vueform/scraper run scrape",
    "scrape:validate": "pnpm --filter @vueform/scraper run validate",
    "scrape:issues": "pnpm --filter @vueform/scraper run issues",
    "docs:dev": "pnpm -r --filter docs run dev",
    "docs:build": "pnpm -r --filter docs run build",
    "docs:preview": "pnpm -r --filter docs run preview",
    "docs:pre": "pnpm -r --filter docs run pre",
    "docs:gen": "pnpm -r --filter docs run gen && pnpm docs:format",
    "docs:cli": "pnpm -r --filter docs run cli && pnpm docs:format",
    "docs:update:ui": "pnpm build --vite --tools && pnpm build --core --ui && pnpm build --expr-eval && pnpm scrape && pnpm docs:gen && pnpm docs:build --ui",
    "---": "--- REVIEWED UNTIL THIS ---",
    "build": "node scripts/build.mjs",
    "build:cdn": "pnpm -r --filter './packages/*' run --if-present build:cdn",
    "bench:perf": "pnpm --filter @vueform/core bench:perf",
    "bench:perf:save": "pnpm --filter @vueform/core bench:perf:save",
    "bench:perf:report": "pnpm --filter @vueform/core bench:perf:report",
    "docs:format": "prettier ./docs --write",
    "gen": "pnpm gen:factory-deps && pnpm gen:pv && pnpm gen:props && pnpm gen:events && pnpm gen:slots",
    "gen:registry": "tsx scripts/gen-registry.ts",
    "validate:styles": "tsx scripts/validate-style-imports.ts",
    "gen:pv": "tsx scripts/gen-primevue.ts",
    "gen:props": "tsx scripts/gen-type-props.ts",
    "gen:events": "tsx scripts/gen-type-events.ts",
    "gen:slots": "tsx scripts/gen-type-slots.ts",
    "tsc": "node scripts/tsc.mjs",
    "tsc:types": "pnpm --filter core run tsc:types",
    "tsc:perf": "pnpm --filter core run tsc:types:perf",
    "test": "pnpm -r --filter core run test",
    "test:core": "pnpm -r --filter core run test",
    "test:pv": "pnpm --filter @vueform/primevue test",
    "test:pv:screenshots": "pnpm --dir packages/primevue exec playwright test",
    "test:pv:screenshots:update": "pnpm --dir packages/primevue exec playwright test --update-snapshots=all",
    "test:ui:screenshots": "pnpm --dir packages/ui exec playwright test",
    "test:ui:screenshots:update": "pnpm --dir packages/ui exec playwright test --update-snapshots=all",
    "test:ui:vapor": "pnpm --filter core run test:vapor && pnpm --filter core run test:vapor:vdom",
    "test:pv:vapor": "pnpm --filter @vueform/primevue run test:vapor && pnpm --filter @vueform/primevue run test:vapor:vdom",
    "test:vapor": "pnpm test:ui:vapor && pnpm test:pv:vapor",
    "test:prod": "pnpm -r --filter core run test:prod",
    "perf:rebase": "pnpm --filter @vueform/core perf:rebase",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:css": "stylelint \"**/*.scss\"",
    "lint:css:fix": "stylelint \"**/*.scss\" --fix",
    "lint:staged": "lint-staged",
    "format:check": "prettier . --check",
    "format": "prettier . --write",
    "fix": "pnpm run lint:fix && pnpm run format",
    "check": "pnpm run lint && pnpm run lint:css && pnpm run format:check && pnpm run tc",
    "clean": "find . -name \"node_modules\" -type d -prune -exec rm -rf '{}' + || true; find . -name \"pnpm-lock.yaml\" -type f -prune -exec rm -rf '{}' + || true;",
    "clean-modules": "find . -name \"node_modules\" -type d -prune -exec rm -rf '{}' +",
    "re": "pnpm clean-modules && pnpm install",
    "bump": "pnpm -r update && pnpm dedupe",
    "prepare": "husky",
    "smoke:e2e": "node scripts/smoke-e2e.mjs"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@inquirer/prompts": "^8.5.2",
    "@types/node": "^24.6.1",
    "@typescript-eslint/eslint-plugin": "^8.52.0",
    "@typescript-eslint/parser": "^8.52.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/tsconfig": "^0.7.0",
    "ajv": "^8.20.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-perfectionist": "^5.10.1",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-unused-imports": "^4.3.0",
    "eslint-plugin-vue": "^10.6.2",
    "fast-glob": "^3.3.3",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.7.4",
    "prettier-plugin-jsdoc": "^1.8.0",
    "stylelint": "^17.8.0",
    "stylelint-config-recess-order": "^7.7.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "stylelint-order": "^8.1.1",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3",
    "vite": "^6.3.6",
    "vite-plugin-dts": "^4.5.4",
    "vue": "^3.5.42",
    "vue-compiler-sfc-vapor": "npm:@vue/compiler-sfc@3.6.0-rc.5",
    "vue-eslint-parser": "^10.2.0",
    "vue-tsc": "^2.2.12",
    "vue-vapor": "npm:vue@3.6.0-rc.5"
  },
  "pnpm": {
    "overrides": {
      "vue": "$vue"
    }
  },
  "lint-staged": {
    "*.{js,ts,vue}": [
      "pnpm eslint --fix",
      "pnpm prettier --write"
    ],
    "*.scss": [
      "pnpm stylelint --fix",
      "pnpm prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "pnpm prettier --write"
    ]
  }
}

    "primevue": {
      "disabled": true,
      "displayName": "PrimeVue",
      "alias": ["pv"],
      "host": "https://primevue.vueform.com",
      "devPort": 5174,
      "github": "https://github.com/vueform/next",
      "path": "packages/primevue",
      "config": "docs/.vitepress/adapters/primevue/config.ts",
      "typesOutputDir": "src/types/_primevue",
      "docsUrl": "https://primevue.org/{component}/#api.{component}.props",
      "tagLinks": {
        "pattern": "https://primevue.org/{tag}/",
        "overrides": {}
      },
      "frameworkProps": {
        "unavailable": {
          "as": "Use [`href`](#props.href) prop instead.",
          "asChild": "Use [`template`](#slots.Slots) slot instead.",
          "binary": "Vueform checkboxes are always binary. Use `trueValue`/`falseValue`.",
          "fluid": "Use [`columns`](#props.columns) prop instead.",
          "formControl": "Vueform manages form control registration internally.",
          "indeterminate": "Managed by Vueform's checkbox state system.",
          "inputId": "Use [`id`](#props.id) prop instead.",
          "invalid": "Managed automatically by Vueform's validation system.",
          "label": "Use [`text`](#props.text) prop instead.",
          "link": "Use `link` value for [`variant`](#props.variant) prop instead.",
          "text": "Use `text` value for [`variant`](#props.variant) prop instead.",
          "type": "Use [`inputType`](#props.inputType) prop instead."
        },
        "modified": {
          "size": "Use Vueform's `size` prop which integrates with the design token system.",
          "variant": "Use Vueform's `variant` prop which integrates with the design token system.",
          "inputClass": "Use Vueform's `classes` prop with the `input` key.",
          "inputStyle": "Use Vueform's `parts` prop with the `input` key.",
          "ariaLabelledby": "Managed by Vueform's accessibility system via the `aria` prop.",
          "ariaLabel": "Managed by Vueform's accessibility system via the `aria` prop.",
          "value": "Use Vueform's `radioValue` prop for radio buttons.",
          "inline": "Replaced by `inlined` to avoid conflict with Vueform's layout `inline` prop.",
          "view": "Replaced by `display` to avoid conflict with Vueform's template `view` prop."
        }
      },
      "overrides": {
        "types": {
          "text": "input-text",
          "checkboxes": "checkbox-group",
          "radios": "radio-button-group",
          "radio": "radio-button"
        },
        "components": {
          "VfText": "VfInputText",
          "VfCheckboxes": "VfCheckboxGroup",
          "VfRadios": "VfRadioButtonGroup",
          "VfRadio": "VfRadioButton"
        },
        "props": {
          " Items": " Options",
          "\"items\"": "\"options\"",
          "'items'": "'options'",
          "items:": "options:",
          "items=": "options=",
          "itemLabel:": "optionLabel:",
          "item-label=": "option-label=",
          "itemValue:": "optionValue:",
          "item-value=": "option-value=",
          "itemDisabled:": "optionDisabled:",
          "item-disabled=": "option-disabled=",
          "itemConditions:": "optionConditions:",

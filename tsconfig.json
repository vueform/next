{
  "extends": ["@vue/tsconfig/tsconfig.dom.json"],
  "compilerOptions": {
    "types": ["vitest/globals", "node"],
    "rootDir": ".",
    "paths": {
      "#core": ["./packages/core/src/index.ts"],
      "#core/*": ["./packages/core/src/*"],
      "#ui": ["./packages/ui/src/index.ts"],
      "#ui/*": ["./packages/ui/src/*"],
      "#primevue": ["./packages/primevue/src/index.ts"],
      "#primevue/*": ["./packages/primevue/src/*"],
      "#expr-eval": ["./packages/expr-eval/src/index.ts"],
      "@vueform/expr-eval": ["./packages/expr-eval/src/index.ts"],
      "#dompurify": ["./packages/dompurify/src/index.ts"],
      "@vueform/core": ["./packages/core/src/index.ts"],
      "@vueform/core/blueprints/*": ["./packages/core/src/blueprints/*.ts"],
      "@vueform/core/components": ["./packages/core/src/components/index.ts"],
      "@vueform/core/components/*/raw": ["./packages/core/src/components/*/index.ts"],
      "@vueform/core/components/*": ["./packages/core/src/components/*/unstyled.ts"],
      "@vueform/core/locales": ["./packages/core/src/locales/index.ts"],
      "@vueform/core/modules": ["./packages/core/src/modules/modules.ts"],
      "@vueform/core/rules": ["./packages/core/src/rules/index.ts"],
      "@vueform/core/tokens": ["./packages/core/src/tokens/index.ts"],
      "@vueform/core/*": ["./packages/core/src/*"],
      "@vueform/ui": ["./packages/ui/src/index.ts"],
      "@vueform/ui/blueprints/*": ["./packages/ui/src/blueprints/*.ts"],
      "@vueform/ui/components": ["./packages/ui/src/components/index.ts"],
      "@vueform/ui/components/names": ["./packages/ui/src/components/names.ts"],
      "@vueform/ui/components/*/raw": ["./packages/ui/src/components/*/index.ts"],
      "@vueform/ui/components/*/unstyled": ["./packages/ui/src/components/*/unstyled.ts"],
      "@vueform/ui/components/*": ["./packages/ui/src/components/*/styled.ts"],
      "@vueform/ui/locales": ["./packages/ui/src/locales/index.ts"],
      "@vueform/ui/modules": ["./packages/ui/src/modules/modules.ts"],
      "@vueform/ui/rules": ["./packages/ui/src/rules/index.ts"],
      "@vueform/ui/themes": ["./packages/ui/src/themes/index.ts"],
      "@vueform/ui/origin": ["./packages/ui/src/origin.ts"],
      "@vueform/ui/material": ["./packages/ui/src/material.ts"],
      "@vueform/ui/*": ["./packages/ui/src/*"]
    }
  },
  "include": [],
  "references": [
    {
      "path": "./tsconfig.node.json"
    }
  ]
}

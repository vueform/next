node_modules
dist
pnpm-lock.yaml

# Markdown is not prettier-formatted: prettier unconditionally normalizes GFM
# tables to padded style (no option exists to tune it), which fights the
# generators' compact tables and restyles docs on prettier upgrades.
*.md

# Generated outputs own their formatting entirely.
.playgrounds
packages/*/registry
packages/metrics/results/
packages/core/tests/perf/.results/
packages/core/tests/perf-dts/.results/


# ── Oxfmt owns TS/JS/JSON formatting (config: .oxfmtrc.json) ─────────────
# Prettier keeps .vue (oxfmt's `semi: false` corrupts v-on handlers), .scss,
# yaml, and the printWidth-override files below.
*.ts
*.mts
*.cts
*.js
*.mjs
*.cjs
*.json
!tsconfig.*
!**/tsconfig.*
!docs/.vitepress/config.mts
!docs/.vitepress/adapters/ui/config.ts
!docs/.vitepress/adapters/primevue/config.ts
!packages/core/vitest.config.ts
!packages/core/tests/dts/**

{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "semi": false,
  "singleQuote": true,
  "tabWidth": 2,
  "trailingComma": "es5",
  "printWidth": 80,
  "jsdocPrintWidth": 80,
  "jsdocDescriptionWithDot": false,
  "jsdocCapitalizeDescription": false,
  "jsdocCommentLineStrategy": "multiline",
  "sortPackageJson": {},
  "ignorePatterns": [
    "node_modules",
    "dist",
    "pnpm-lock.yaml",
    "*.md",
    ".playgrounds",
    "packages/*/registry",
    "packages/metrics/results/",
    "packages/core/tests/perf/.results/",
    "packages/core/tests/perf-dts/.results/",
    "**/*.vue",
    "**/*.scss",
    "tsconfig.*",
    "**/tsconfig.*",
    "docs/.vitepress/config.mts",
    "docs/.vitepress/adapters/ui/config.ts",
    "docs/.vitepress/adapters/primevue/config.ts",
    "packages/core/vitest.config.ts",
    "packages/core/tests/dts/**",
    "docs/src/playground/**"
  ]
}

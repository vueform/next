{
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node"],
    "strict": true,
    "verbatimModuleSyntax": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "emitDeclarationOnly": true,
    "outDir": "node_modules/.tmp/tsconfig.node",
    "tsBuildInfoFile": "node_modules/.tmp/tsconfig.node.tsbuildinfo"
  },
  "include": [
    "*.config.ts",
    "*.config.*.ts",
    "scripts",
    "packages/*/tests/bench-dts/generate.ts"
  ],
  "exclude": ["scripts/playground/templates"]
}

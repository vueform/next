// Repo-wide policy for node-side TypeScript (vite configs, repo scripts):
// @tsconfig/node22 pins target/lib/strict/interop; overrides here are the
// bundler-execution reality (tsx/vite run these files, tsc never emits).
{
  "extends": "@tsconfig/node22/tsconfig.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "moduleDetection": "force",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "isolatedModules": true,
    "types": ["node"],
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noUncheckedSideEffectImports": true
  }
}

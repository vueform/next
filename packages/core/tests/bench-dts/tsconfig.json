{
  // Consumer view: @vueform/* resolves to BUILT dist types — the same types
  // a user's editor evaluates. Requires a prior core build.
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": []
  },
  "include": ["."]
}

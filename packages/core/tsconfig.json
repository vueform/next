{
  // Solution file; the `extends` is for @vue/compiler-sfc, which reads the
  // nearest tsconfig.json literally (no `references`) and needs the preset's
  // moduleResolution + customConditions to resolve SFC macro types (`#src`,
  // `@vueform/*`). Without it the build fails on every SFC.
  "extends": "@vueform/tsconfig/tsconfig.dom.json",
  "files": [],
  "references": [
    { "path": "./tsconfig.app.json" },
    { "path": "./tsconfig.test.json" },
    { "path": "./tsconfig.node.json" }
  ]
}

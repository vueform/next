{
  "name": "@vueform/core",
  "version": "2.0.0",
  "description": "Vueform Core 2.0",
  "author": "Adam Berecz",
  "license": "MIT",
  "private": false,
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs"
    },
    "./blueprints/*": {
      "types": "./dist/blueprints/*.d.ts",
      "import": "./dist/blueprints/*.mjs"
    },
    "./components": {
      "types": "./dist/components/index.d.ts",
      "import": "./dist/components/index.mjs"
    },
    "./components/shared": {
      "types": "./dist/components/shared/index.d.ts",
      "import": "./dist/components/shared/index.mjs"
    },
    "./components/*/raw": {
      "types": "./dist/components/*/index.d.ts",
      "import": "./dist/components/*/index.mjs"
    },
    "./components/*": {
      "types": "./dist/components/*/unstyled.d.ts",
      "import": "./dist/components/*/unstyled.mjs"
    },
    "./rules": {
      "types": "./dist/defaultRules.d.ts",
      "import": "./dist/defaultRules.mjs"
    },
    "./modules": {
      "types": "./dist/modules/modules.d.ts",
      "import": "./dist/modules/modules.mjs"
    },
    "./locales": {
      "types": "./dist/locales/index.d.ts",
      "import": "./dist/locales/index.mjs"
    },
    "./tokens": {
      "types": "./dist/tokens/index.d.ts",
      "import": "./dist/tokens/index.mjs"
    },
    "./*.css": {
      "node": "./dist/css/*.css.mjs",
      "default": "./dist/css/*.css"
    },
    "./*.scss": {
      "node": "./dist/scss/*.scss.mjs",
      "default": "./dist/scss/*.scss"
    },
    "./vapor": {
      "types": "./dist/index.d.ts",
      "import": "./dist/vapor/index.mjs"
    },
    "./vapor/blueprints/*": {
      "types": "./dist/blueprints/*.d.ts",
      "import": "./dist/vapor/blueprints/*.mjs"
    },
    "./vapor/components": {
      "types": "./dist/components/index.d.ts",
      "import": "./dist/vapor/components/index.mjs"
    },
    "./vapor/components/shared": {
      "types": "./dist/components/shared/index.d.ts",
      "import": "./dist/vapor/components/shared/index.mjs"
    },
    "./vapor/components/*/raw": {
      "types": "./dist/components/*/index.d.ts",
      "import": "./dist/vapor/components/*/index.mjs"
    },
    "./vapor/components/*": {
      "types": "./dist/components/*/unstyled.d.ts",
      "import": "./dist/vapor/components/*/unstyled.mjs"
    },
    "./vapor/rules": {
      "types": "./dist/defaultRules.d.ts",
      "import": "./dist/vapor/defaultRules.mjs"
    },
    "./vapor/modules": {
      "types": "./dist/modules/modules.d.ts",
      "import": "./dist/vapor/modules/modules.mjs"
    },
    "./vapor/locales": {
      "types": "./dist/locales/index.d.ts",
      "import": "./dist/vapor/locales/index.mjs"
    },
    "./vapor/tokens": {
      "types": "./dist/tokens/index.d.ts",
      "import": "./dist/vapor/tokens/index.mjs"
    },
    "./nuxt": {
      "types": "./nuxt/index.ts",
      "import": "./nuxt/index.ts"
    }
  },
  "files": [
    "dist",
    "nuxt"
  ],
  "sideEffects": [
    "**/*.css",
    "**/*.scss"
  ],
  "scripts": {
    "build": "pnpm run build:vdom && pnpm run build:vapor",
    "build:vdom": "vite build",
    "build:vapor": "vite build --config build/vite.config.vapor.ts",
    "gen": "tsx ./scripts/generate-blueprints.ts",
    "gen:deps": "tsx ./scripts/generate-factory-deps.ts",
    "gen:schema-perf": "tsx ./scripts/generate-schema-perf.ts",
    "tsc": "pnpm exec vue-tsc --project .tsconfig/tsconfig.build.json",
    "tsc:types": "pnpm exec vue-tsc --project .tsconfig/tsconfig.types.json",
    "tsc:types:perf": "tsx ./scripts/run-schema-perf.ts",
    "test": "vitest --config tests/vitest.config.ts --maxWorkers=16",
    "bench:perf": "node tests/perf/runtime/scripts/run.mjs",
    "bench:perf:save": "node tests/perf/runtime/scripts/run.mjs --save",
    "bench:perf:report": "node tests/perf/runtime/scripts/run.mjs --report",
    "perf:rebase": "node tests/perf/runtime/scripts/run.mjs --rebase",
    "test:prod": "vitest --config tests/vitest.config.ts --maxWorkers=16 --mode production",
    "test:vapor": "vitest run --config tests/env/vapor/vitest.config.ts",
    "test:vapor:vdom": "VAPOR_ALL=0 vitest run --config tests/env/vapor/vitest.config.ts",
    "publish": "pnpm build && pnpm republish",
    "republish": "pnpm unpublish --force --no-git-checks && pnpm publish --no-git-checks"
  },
  "dependencies": {
    "@vueform/devtools": "workspace:*",
    "@vueuse/core": "catalog:",
    "type-fest": "catalog:"
  },
  "devDependencies": {
    "@nuxt/kit": "^3.17.5",
    "@nuxt/schema": "^3.17.5",
    "@vitejs/plugin-vue": "catalog:",
    "@vue/shared": "^3.5.28",
    "@vue/test-utils": "catalog:",
    "@vueform/vite": "workspace:*",
    "fast-glob": "catalog:",
    "happy-dom": "catalog:",
    "sass-embedded": "catalog:",
    "vite": "catalog:",
    "vite-plugin-dts": "catalog:",
    "vitest": "catalog:",
    "zod": "^4.6.5"
  },
  "peerDependencies": {
    "@nuxt/kit": "^3.17.5",
    "@nuxt/schema": "^3.17.5",
    "vue": "^3.5.13"
  },
  "peerDependenciesMeta": {
    "@nuxt/kit": {
      "optional": true
    },
    "@nuxt/schema": {
      "optional": true
    }
  }
}

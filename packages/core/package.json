{
  "name": "@vueform/core",
  "version": "2.0.0-alpha.1",
  "description": "Headless, schema-driven form framework core for Vue 3 — elements, validation, conditions and form state.",
  "keywords": [
    "form",
    "forms",
    "headless",
    "schema",
    "validation",
    "vue",
    "vue3",
    "vueform"
  ],
  "homepage": "https://github.com/vueform/next",
  "bugs": "https://github.com/vueform/next/issues",
  "license": "MIT",
  "author": "Adam Berecz",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vueform/next.git",
    "directory": "packages/core"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css",
    "**/*.scss"
  ],
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "imports": {
    "#src": "./src/index.ts",
    "#src/*": [
      "./src/*",
      "./src/*.ts",
      "./src/*/index.ts"
    ]
  },
  "exports": {
    ".": {
      "dev": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs"
    },
    "./*.css": {
      "node": "./dist/css/*.css.mjs",
      "default": "./dist/css/*.css"
    },
    "./*.scss": {
      "node": "./dist/scss/*.scss.mjs",
      "default": "./dist/scss/*.scss"
    },
    "./blueprints/*": {
      "dev": "./src/blueprints/*.ts",
      "types": "./dist/blueprints/*.d.ts",
      "import": "./dist/blueprints/*.mjs"
    },
    "./components": {
      "dev": "./src/components/index.ts",
      "types": "./dist/components/index.d.ts",
      "vapor": "./dist/vapor/components/index.mjs",
      "import": "./dist/components/index.mjs"
    },
    "./components/*/raw": {
      "dev": "./src/components/*/index.ts",
      "types": "./dist/components/*/index.d.ts",
      "vapor": "./dist/vapor/components/*/index.mjs",
      "import": "./dist/components/*/index.mjs"
    },
    "./components/*": {
      "dev": "./src/components/*/unstyled.ts",
      "types": "./dist/components/*/unstyled.d.ts",
      "vapor": "./dist/vapor/components/*/unstyled.mjs",
      "import": "./dist/components/*/unstyled.mjs"
    },
    "./vapor/components": {
      "dev": "./src/components/index.ts",
      "types": "./dist/components/index.d.ts",
      "import": "./dist/vapor/components/index.mjs"
    },
    "./vapor/components/*/raw": {
      "dev": "./src/components/*/index.ts",
      "types": "./dist/components/*/index.d.ts",
      "import": "./dist/vapor/components/*/index.mjs"
    },
    "./vapor/components/*": {
      "dev": "./src/components/*/unstyled.ts",
      "types": "./dist/components/*/unstyled.d.ts",
      "import": "./dist/vapor/components/*/unstyled.mjs"
    },
    "./locales": {
      "dev": "./src/locales/index.ts",
      "types": "./dist/locales/index.d.ts",
      "import": "./dist/locales/index.mjs"
    },
    "./modules": {
      "dev": "./src/modules/modules.ts",
      "types": "./dist/modules/modules.d.ts",
      "import": "./dist/modules/modules.mjs"
    },
    "./rules": {
      "dev": "./src/rules/index.ts",
      "types": "./dist/rules/index.d.ts",
      "import": "./dist/rules/index.mjs"
    },
    "./tokens": {
      "dev": "./src/tokens/index.ts",
      "types": "./dist/tokens/index.d.ts",
      "import": "./dist/tokens/index.mjs"
    }
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.mjs"
      },
      "./*.css": {
        "node": "./dist/css/*.css.mjs",
        "default": "./dist/css/*.css"
      },
      "./*.scss": {
        "node": "./dist/scss/*.scss.mjs",
        "default": "./dist/scss/*.scss"
      },
      "./blueprints/*": {
        "types": "./dist/blueprints/*.d.ts",
        "import": "./dist/blueprints/*.mjs"
      },
      "./components": {
        "types": "./dist/components/index.d.ts",
        "vapor": "./dist/vapor/components/index.mjs",
        "import": "./dist/components/index.mjs"
      },
      "./components/*/raw": {
        "types": "./dist/components/*/index.d.ts",
        "vapor": "./dist/vapor/components/*/index.mjs",
        "import": "./dist/components/*/index.mjs"
      },
      "./components/*": {
        "types": "./dist/components/*/unstyled.d.ts",
        "vapor": "./dist/vapor/components/*/unstyled.mjs",
        "import": "./dist/components/*/unstyled.mjs"
      },
      "./vapor/components": {
        "types": "./dist/components/index.d.ts",
        "import": "./dist/vapor/components/index.mjs"
      },
      "./vapor/components/*/raw": {
        "types": "./dist/components/*/index.d.ts",
        "import": "./dist/vapor/components/*/index.mjs"
      },
      "./vapor/components/*": {
        "types": "./dist/components/*/unstyled.d.ts",
        "import": "./dist/vapor/components/*/unstyled.mjs"
      },
      "./locales": {
        "types": "./dist/locales/index.d.ts",
        "import": "./dist/locales/index.mjs"
      },
      "./modules": {
        "types": "./dist/modules/modules.d.ts",
        "import": "./dist/modules/modules.mjs"
      },
      "./rules": {
        "types": "./dist/rules/index.d.ts",
        "import": "./dist/rules/index.mjs"
      },
      "./tokens": {
        "types": "./dist/tokens/index.d.ts",
        "import": "./dist/tokens/index.mjs"
      }
    },
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && vue-tsc -p tsconfig.build.json && tsdown && tsdown -c tsdown.vapor.config.ts",
    "publint": "publint",
    "size": "vf-size",
    "test": "vitest --project integration --maxWorkers=16",
    "test-dts": "vitest run --project test-dts",
    "typecheck": "vue-tsc -p tsconfig.app.json --noEmit && vue-tsc -p tsconfig.test.json --noEmit && tsc -p tsconfig.node.json --noEmit"
  },
  "dependencies": {
    "@vue/devtools-api": "catalog:"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "catalog:",
    "@vue/shared": "catalog:",
    "@vue/test-utils": "catalog:",
    "@vueform/tsconfig": "workspace:*",
    "@vueform/utils": "workspace:^",
    "fast-glob": "catalog:",
    "happy-dom": "catalog:",
    "sass-embedded": "catalog:",
    "tsdown": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "vue-compiler-sfc-vapor": "catalog:",
    "vue-tsc": "catalog:",
    "vue-vapor": "catalog:",
    "zod": "catalog:"
  },
  "peerDependencies": {
    "vue": "catalog:peer"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}

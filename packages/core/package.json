{
  "name": "@vueform/core",
  "version": "2.0.0",
  "description": "Vueform Core 2.0",
  "author": "Adam Berecz",
  "license": "MIT",
  "private": false,
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs"
    },
    "./blueprints/*": {
      "types": "./dist/blueprints/*.d.ts",
      "import": "./dist/blueprints/*.mjs"
    },
    "./components": {
      "types": "./dist/components/index.d.ts",
      "import": "./dist/components/index.mjs"
    },
    "./components/*/raw": {
      "types": "./dist/components/*/index.d.ts",
      "import": "./dist/components/*/index.mjs"
    },
    "./components/*": {
      "types": "./dist/components/*/unstyled.d.ts",
      "import": "./dist/components/*/unstyled.mjs"
    },
    "./rules": {
      "types": "./dist/defaultRules.d.ts",
      "import": "./dist/defaultRules.mjs"
    },
    "./modules": {
      "types": "./dist/modules/modules.d.ts",
      "import": "./dist/modules/modules.mjs"
    },
    "./locales": {
      "types": "./dist/locales/index.d.ts",
      "import": "./dist/locales/index.mjs"
    },
    "./tokens": {
      "types": "./dist/tokens/index.d.ts",
      "import": "./dist/tokens/index.mjs"
    },
    "./*.css": {
      "node": "./dist/css/*.css.mjs",
      "default": "./dist/css/*.css"
    },
    "./*.scss": {
      "node": "./dist/scss/*.scss.mjs",
      "default": "./dist/scss/*.scss"
    },
    "./vapor": {
      "types": "./dist/index.d.ts",
      "import": "./dist/vapor/index.mjs"
    },
    "./vapor/blueprints/*": {
      "types": "./dist/blueprints/*.d.ts",
      "import": "./dist/vapor/blueprints/*.mjs"
    },
    "./vapor/components": {
      "types": "./dist/components/index.d.ts",
      "import": "./dist/vapor/components/index.mjs"
    },
    "./vapor/components/*/raw": {
      "types": "./dist/components/*/index.d.ts",
      "import": "./dist/vapor/components/*/index.mjs"
    },
    "./vapor/components/*": {
      "types": "./dist/components/*/unstyled.d.ts",
      "import": "./dist/vapor/components/*/unstyled.mjs"
    },
    "./vapor/rules": {
      "types": "./dist/defaultRules.d.ts",
      "import": "./dist/vapor/defaultRules.mjs"
    },
    "./vapor/modules": {
      "types": "./dist/modules/modules.d.ts",
      "import": "./dist/vapor/modules/modules.mjs"
    },
    "./vapor/locales": {
      "types": "./dist/locales/index.d.ts",
      "import": "./dist/vapor/locales/index.mjs"
    },
    "./vapor/tokens": {
      "types": "./dist/tokens/index.d.ts",
      "import": "./dist/vapor/tokens/index.mjs"
    },
    "./nuxt": {
      "types": "./nuxt/index.ts",
      "import": "./nuxt/index.ts"
    }
  },
  "files": [
    "dist",
    "nuxt"
  ],
  "sideEffects": [
    "**/*.css",
    "**/*.scss"
  ],
  "scripts": {
    "typecheck": "pnpm tsc:src && pnpm tsc:test && pnpm tsc:test:types && pnpm tsc:test:vapor && pnpm tsc:node",
    "tsc:src": "pnpm exec vue-tsc --project tsconfig.build.json",
    "tsc:test": "pnpm exec vue-tsc --project tests/tsconfig.json --noEmit",
    "tsc:node": "tsc --project tsconfig.node.json --noEmit",
    "=== END ===": "",
    "tsc:test:types": "pnpm exec vue-tsc --project tests/types/tsconfig.json --noEmit",
    "tsc:test:vapor": "pnpm exec vue-tsc --project tests/env/vapor/tsconfig.json --noEmit",
    "tsc:types:perf": "tsx ./tests/perf/types/scripts/run-schema-perf.ts",
    "build": "pnpm run build:vdom && pnpm run build:vapor",
    "build:vdom": "vite build",
    "build:vapor": "vite build --config build/vite.config.vapor.ts",
    "gen:schema-perf": "tsx ./tests/perf/types/scripts/generate-schema-perf.ts",
    "test": "vitest --maxWorkers=16",
    "bench:perf": "tsx tests/perf/runtime/scripts/run.ts",
    "bench:perf:save": "tsx tests/perf/runtime/scripts/run.ts --save",
    "bench:perf:report": "tsx tests/perf/runtime/scripts/run.ts --report",
    "perf:rebase": "tsx tests/perf/runtime/scripts/run.ts --rebase",
    "test:prod": "vitest --maxWorkers=16 --mode production",
    "test:vapor": "vitest run --project vapor",
    "test:vapor:vdom": "VAPOR_ALL=0 vitest run --project vapor"
  },
  "dependencies": {
    "@vueform/devtools": "workspace:^"
  },
  "devDependencies": {
    "@nuxt/kit": "catalog:",
    "@nuxt/schema": "catalog:",
    "@vitejs/plugin-vue": "catalog:",
    "@vue/shared": "catalog:",
    "@vue/test-utils": "catalog:",
    "@vueform/vite": "workspace:^",
    "fast-glob": "catalog:",
    "happy-dom": "catalog:",
    "sass-embedded": "catalog:",
    "vite": "catalog:",
    "vite-plugin-dts": "catalog:",
    "vitest": "catalog:",
    "vue-compiler-sfc-vapor": "catalog:",
    "vue-vapor": "catalog:",
    "zod": "catalog:"
  },
  "peerDependencies": {
    "vue": "catalog:peer"
  }
}

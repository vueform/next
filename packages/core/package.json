{
  "name": "@vueform/core",
  "version": "2.0.0",
  "description": "Vueform Core 2.0",
  "author": "Adam Berecz",
  "license": "MIT",
  "private": false,
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs"
    },
    "./blueprints/*": {
      "types": "./dist/blueprints/*.d.ts",
      "import": "./dist/blueprints/*.mjs"
    },
    "./components": {
      "types": "./dist/components/index.d.ts",
      "import": "./dist/components/index.mjs"
    },
    "./components/*/raw": {
      "types": "./dist/components/*/index.d.ts",
      "import": "./dist/components/*/index.mjs"
    },
    "./components/*": {
      "types": "./dist/components/*/unstyled.d.ts",
      "import": "./dist/components/*/unstyled.mjs"
    },
    "./rules": {
      "types": "./dist/defaultRules.d.ts",
      "import": "./dist/defaultRules.mjs"
    },
    "./modules": {
      "types": "./dist/modules/modules.d.ts",
      "import": "./dist/modules/modules.mjs"
    },
    "./locales": {
      "types": "./dist/locales/index.d.ts",
      "import": "./dist/locales/index.mjs"
    },
    "./tokens": {
      "types": "./dist/tokens/index.d.ts",
      "import": "./dist/tokens/index.mjs"
    },
    "./*.css": {
      "node": "./dist/css/*.css.mjs",
      "default": "./dist/css/*.css"
    },
    "./*.scss": {
      "node": "./dist/scss/*.scss.mjs",
      "default": "./dist/scss/*.scss"
    },
    "./vapor": {
      "types": "./dist/index.d.ts",
      "import": "./dist/vapor/index.mjs"
    },
    "./vapor/blueprints/*": {
      "types": "./dist/blueprints/*.d.ts",
      "import": "./dist/vapor/blueprints/*.mjs"
    },
    "./vapor/components": {
      "types": "./dist/components/index.d.ts",
      "import": "./dist/vapor/components/index.mjs"
    },
    "./vapor/components/*/raw": {
      "types": "./dist/components/*/index.d.ts",
      "import": "./dist/vapor/components/*/index.mjs"
    },
    "./vapor/components/*": {
      "types": "./dist/components/*/unstyled.d.ts",
      "import": "./dist/vapor/components/*/unstyled.mjs"
    },
    "./vapor/rules": {
      "types": "./dist/defaultRules.d.ts",
      "import": "./dist/vapor/defaultRules.mjs"
    },
    "./vapor/modules": {
      "types": "./dist/modules/modules.d.ts",
      "import": "./dist/vapor/modules/modules.mjs"
    },
    "./vapor/locales": {
      "types": "./dist/locales/index.d.ts",
      "import": "./dist/vapor/locales/index.mjs"
    },
    "./vapor/tokens": {
      "types": "./dist/tokens/index.d.ts",
      "import": "./dist/vapor/tokens/index.mjs"
    },
    "./nuxt": {
      "types": "./nuxt/index.ts",
      "import": "./nuxt/index.ts"
    }
  },
  "files": [
    "dist",
    "nuxt"
  ],
  "sideEffects": [
    "**/*.css",
    "**/*.scss"
  ],
  "dependencies": {
    "@vueform/devtools": "workspace:^"
  },
  "devDependencies": {
    "@nuxt/kit": "catalog:",
    "@nuxt/schema": "catalog:",
    "@vitejs/plugin-vue": "catalog:",
    "@vue/shared": "catalog:",
    "@vue/test-utils": "catalog:",
    "@vueform/vite": "workspace:^",
    "fast-glob": "catalog:",
    "happy-dom": "catalog:",
    "sass-embedded": "catalog:",
    "vite": "catalog:",
    "vite-plugin-dts": "catalog:",
    "vitest": "catalog:",
    "vue-compiler-sfc-vapor": "catalog:",
    "vue-vapor": "catalog:",
    "zod": "catalog:"
  },
  "peerDependencies": {
    "vue": "catalog:peer"
  }
}

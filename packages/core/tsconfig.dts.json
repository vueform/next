{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // Declaration-only emission for the tsdown build: vue-tsc preserves the
    // per-module d.ts shape (`export *` barrels stay verbatim), which
    // rolldown-plugin-dts' bundling rewrites into explicit name lists that
    // silently drop `export *`-carried type names (seen as TS2742 in the
    // adapters). The build script runs this between the main tsdown pass
    // (JS) and the vapor pass.
    "declaration": true,
    "emitDeclarationOnly": true,
    "noEmit": false,
    "rootDir": "src",
    "outDir": "dist"
  },
  "include": ["../global.d.ts", "src"]
}

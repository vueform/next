// `pnpm tsc:node` — vite/build configs, nuxt module, scripts, perf runner.
{
  "extends": "../../../tsconfig.node.base.json",
  "compilerOptions": {
    "tsBuildInfoFile": "../node_modules/.tmp/tsconfig.node.tsbuildinfo"
  },
  "include": [
    "../vite.config.ts",
    "../build/**/*.ts",
    "../nuxt/*.ts",
    "../scripts/**/*.ts",
    "../tests/perf/runtime/scripts/**/*.ts"
  ]
}

{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "compilerOptions": {
    "types": ["node", "vitest/globals"],
    "paths": {
      "~/*": ["../src/*"],
      "#shorthands": ["../src/types/shorthands.ts"],
      "@vueform/core": ["../src/index.ts"],
      "@vueform/core/blueprints/*": ["../src/blueprints/*"],
      "@vueform/core/components": ["../src/components/index.ts"],
      "@vueform/core/components/*/raw": ["../src/components/*/index.ts"],
      "@vueform/core/components/*": ["../src/components/*/unstyled.ts"],
      "@vueform/core/rules": ["../src/rules/index.ts"],
      "@vueform/core/modules": ["../src/modules/modules.ts"],
      "@vueform/core/locales": ["../src/locales/index.ts"],
      "@vueform/core/*": ["../src/*"],
      "@vueform/dompurify": ["../../dompurify/src/index.ts"],
      "@vueform/expr-eval": ["../../expr-eval/src/index.ts"]
    },
    "noImplicitAny": false
  },
  "include": [
    "../src/**/*.ts",
    "../src/**/*.d.ts",
    "../src/**/*.vue",
    "../tests/**/*.ts",
    "../tests/**/*.vue",
    "../tests/integration/.fixture/**/*.vue"
  ],
  "exclude": ["../tests/type/**/*", "../tests/env/vapor/**/*"]
}

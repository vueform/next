{
  "name": "@vueform/dompurify",
  "version": "2.0.0-alpha.1",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "types": "./dist/index.d.ts"
    }
  },
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "check": "tsc --noEmit",
    "size": "vf-size",
    "size:report": "vf-size --report"
  },
  "dependencies": {
    "isomorphic-dompurify": "catalog:"
  },
  "devDependencies": {
    "@vueform/ui": "workspace:^",
    "@vueform/utils": "workspace:^",
    "tsdown": "catalog:",
    "vite": "catalog:"
  },
  "peerDependencies": {
    "@vueform/core": "workspace:^",
    "vue": "catalog:peer"
  },
  "vueform": {
    "group": "plugins",
    "size": {
      "dep": "isomorphic-dompurify",
      "depImport": "import DOMPurify from 'isomorphic-dompurify'",
      "depRetain": "console.log(DOMPurify.sanitize('<b>vueform</b>'))"
    }
  }
}

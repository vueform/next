{
  "name": "@vueform/dompurify",
  "version": "2.0.0-alpha.1",
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "imports": {
    "#src": "./src/index.ts",
    "#src/*": [
      "./src/*",
      "./src/*.ts",
      "./src/*/index.ts"
    ]
  },
  "exports": {
    ".": {
      "vueform-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs"
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "vue-tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "size": "vf-size",
    "size:report": "vf-size --report"
  },
  "dependencies": {
    "isomorphic-dompurify": "catalog:"
  },
  "devDependencies": {
    "@vueform/tsconfig": "workspace:*",
    "@vueform/ui": "workspace:^",
    "@vueform/utils": "workspace:^",
    "happy-dom": "catalog:",
    "tsdown": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "vue-tsc": "catalog:"
  },
  "peerDependencies": {
    "@vueform/core": "workspace:^",
    "vue": "catalog:peer"
  },
  "vueform": {
    "group": "plugins",
    "size": {
      "dep": "isomorphic-dompurify",
      "depImport": "import DOMPurify from 'isomorphic-dompurify'",
      "depRetain": "console.log(DOMPurify.sanitize('<b>vueform</b>'))"
    }
  }
}

{
  "name": "@vueform/dompurify",
  "version": "2.0.0",
  "description": "DOMPurify security plugin for Vueform",
  "author": "Adam Berecz",
  "license": "MIT",
  "private": false,
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build",
    "typecheck": "vue-tsc --project tsconfig.json --noEmit"
  },
  "dependencies": {
    "isomorphic-dompurify": "catalog:"
  },
  "devDependencies": {
    "vite": "catalog:",
    "vite-plugin-dts": "catalog:"
  },
  "peerDependencies": {
    "@vueform/core": "workspace:^",
    "vue": "catalog:peer"
  },
  "vueform": {
    "group": "plugins"
  }
}

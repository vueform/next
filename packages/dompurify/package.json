{
  "name": "@vueform/dompurify",
  "version": "2.0.0",
  "description": "DOMPurify security plugin for Vueform",
  "author": "Adam Berecz",
  "license": "MIT",
  "private": false,
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build",
    "tsc": "pnpm exec vue-tsc --project .tsconfig/tsconfig.build.json"
  },
  "dependencies": {
    "isomorphic-dompurify": "catalog:"
  },
  "peerDependencies": {
    "@vueform/core": "workspace:*",
    "vue": "^3.5.13"
  },
  "vueform": {
    "group": "plugins"
  }
}

{
  "name": "@vueform/cli",
  "version": "2.0.0-alpha.1",
  "private": false,
  "description": "Vueform CLI",
  "license": "MIT",
  "author": "Adam Berecz",
  "bin": {
    "vueform": "./bin/vueform.js"
  },
  "files": [
    "bin",
    "dist",
    "schema.json"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsdown",
    "publint": "publint",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "test": "vitest"
  },
  "devDependencies": {
    "@vueform/tsconfig": "workspace:*",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}

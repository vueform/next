{
  "name": "@vueform/expr-eval",
  "version": "2.0.0-alpha.1",
  "description": "Expression evaluator used by Vueform for conditions and computed values.",
  "keywords": [
    "evaluator",
    "expression",
    "parser",
    "vueform"
  ],
  "homepage": "https://github.com/vueform/core",
  "bugs": "https://github.com/vueform/core/issues",
  "license": "MIT",
  "author": "Adam Berecz",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vueform/core.git",
    "directory": "packages/expr-eval"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "imports": {
    "#src": "./src/index.ts",
    "#src/*": [
      "./src/*",
      "./src/*.ts",
      "./src/*/index.ts"
    ]
  },
  "exports": {
    ".": {
      "vueform-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "publint": "publint",
    "typecheck": "vue-tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "size": "vf-size",
    "size:report": "vf-size --report"
  },
  "dependencies": {
    "expr-eval-fork": "catalog:"
  },
  "devDependencies": {
    "@vueform/tsconfig": "workspace:*",
    "@vueform/ui": "workspace:^",
    "@vueform/utils": "workspace:^",
    "happy-dom": "catalog:",
    "tsdown": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "vue-tsc": "catalog:"
  },
  "peerDependencies": {
    "@vueform/core": "workspace:^",
    "vue": "catalog:peer"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "vueform": {
    "group": "plugins",
    "size": {
      "dep": "expr-eval-fork",
      "depImport": "import { Parser } from 'expr-eval-fork'",
      "depRetain": "console.log(Parser.evaluate('1 + 2'))"
    }
  }
}

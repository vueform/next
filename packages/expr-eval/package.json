{
  "name": "@vueform/expr-eval",
  "version": "2.0.0-alpha.1",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "types": "./dist/index.d.ts"
    }
  },
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build",
    "check": "tsc --noEmit",
    "size": "vf-size",
    "size:report": "vf-size --report"
  },
  "dependencies": {
    "expr-eval-fork": "catalog:"
  },
  "devDependencies": {
    "@vueform/ui": "workspace:^",
    "@vueform/utils": "workspace:^",
    "vite": "catalog:"
  },
  "peerDependencies": {
    "@vueform/core": "workspace:^",
    "vue": "catalog:peer"
  },
  "vueform": {
    "group": "plugins",
    "size": {
      "dep": "expr-eval-fork",
      "depImport": "import { Parser } from 'expr-eval-fork'",
      "depRetain": "console.log(Parser.evaluate('1 + 2'))"
    }
  }
}

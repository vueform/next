{
  // Editor-only: imports of fixture-supplied files (`../adapter`, …) resolve
  // into editor-stubs/ via `rootDirs`. The templates are verified by the
  // smoke runs themselves (built and exercised in every cell).
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "rootDirs": ["app", "editor-stubs"]
  },
  "include": ["app", "editor-stubs"]
}

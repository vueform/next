{
  "name": "@vueform/utils",
  "version": "2.0.0-alpha.1",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./smoke": {
      "types": "./dist/smoke/index.d.ts",
      "require": "./dist/smoke/index.js",
      "default": "./dist/smoke/index.js"
    },
    "./visual-test": "./visual-test/index.ts"
  },
  "bin": {
    "vf-bench-dts": "./bin/vf-bench-dts.js",
    "vf-registry": "./bin/vf-registry.js",
    "vf-size": "./bin/vf-size.js",
    "vf-validate-source": "./bin/vf-validate-source.js"
  },
  "files": [
    "bin",
    "config.json",
    "dist",
    "smoke-templates",
    "visual-test"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "@vitejs/plugin-vue": "catalog:",
    "ajv": "catalog:",
    "fast-glob": "catalog:",
    "prettier": "catalog:",
    "rollup-plugin-visualizer": "catalog:",
    "typescript": "catalog:",
    "vite-plugin-dts": "catalog:",
    "vue": "catalog:"
  },
  "peerDependencies": {
    "vite": "catalog:peer"
  }
}

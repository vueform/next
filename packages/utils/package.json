{
  "name": "@vueform/utils",
  "version": "2.0.0-alpha.1",
  "description": "Shared build, test and tooling utilities for Vueform packages.",
  "keywords": [
    "tooling",
    "vueform"
  ],
  "homepage": "https://github.com/vueform/next",
  "bugs": "https://github.com/vueform/next/issues",
  "license": "MIT",
  "author": "Adam Berecz",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vueform/next.git",
    "directory": "packages/utils"
  },
  "bin": {
    "vf-registry": "./bin/vf-registry.js",
    "vf-size": "./bin/vf-size.js",
    "vf-smoke": "./bin/vf-smoke.js",
    "vf-smoke-types": "./bin/vf-smoke-types.js"
  },
  "files": [
    "bin",
    "dist",
    "fixtures"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./smoke": {
      "types": "./dist/smoke/index.d.ts",
      "default": "./dist/smoke/index.js"
    },
    "./terminal": {
      "types": "./dist/terminal/index.d.ts",
      "default": "./dist/terminal/index.js"
    },
    "./type-test": {
      "types": "./dist/type-test.d.ts",
      "default": "./dist/type-test.js"
    },
    "./visual-test": "./fixtures/visual-test/index.ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@vitejs/plugin-vue": "catalog:",
    "ajv": "catalog:",
    "fast-glob": "catalog:",
    "oxfmt": "catalog:",
    "rollup-plugin-visualizer": "catalog:",
    "typescript": "catalog:",
    "unplugin-vue": "catalog:",
    "vue": "catalog:"
  },
  "devDependencies": {
    "@vueform/tsconfig": "workspace:*",
    "tsdown": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "vite": "catalog:peer",
    "vitest": "catalog:peer"
  },
  "peerDependenciesMeta": {
    "vitest": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.12.0"
  }
}

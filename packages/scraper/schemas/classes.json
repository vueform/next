{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://vueform.com/schemas/scraper/classes.json",
  "title": "Vueform scraped classes",
  "description": "Documented CSS classes (.vf-* plus virtual classes such as sr-only) keyed by class name without the leading dot (.generated/<source>/classes.json).",
  "type": "object",
  "propertyNames": {
    "pattern": "^[a-z][a-z0-9-]*$"
  },
  "additionalProperties": {
    "type": "object",
    "required": ["description"],
    "additionalProperties": false,
    "properties": {
      "description": {
        "type": "string",
        "minLength": 1
      },
      "file": {
        "type": "string",
        "minLength": 1,
        "description": "Declaring scss file, relative to the monorepo root; absent for virtual classes."
      },
      "line": {
        "type": "integer",
        "minimum": 1,
        "description": "1-based line of the declaration; absent for virtual classes."
      },
      "tokens": {
        "type": "array",
        "minItems": 1,
        "description": "Design tokens the class consumes; absent when none.",
        "items": {
          "type": "string",
          "pattern": "^--vf-[a-z0-9-]+$"
        }
      },
      "modifiers": {
        "type": "object",
        "description": "Modifier classes documented under this root class; absent when none.",
        "additionalProperties": {
          "type": "object",
          "required": ["description", "file", "line"],
          "additionalProperties": false,
          "properties": {
            "description": {
              "type": "string",
              "minLength": 1
            },
            "file": {
              "type": "string",
              "minLength": 1
            },
            "line": {
              "type": "integer",
              "minimum": 1
            },
            "tokens": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "pattern": "^--vf-[a-z0-9-]+$"
              }
            }
          }
        }
      }
    }
  }
}

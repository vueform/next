{
  "name": "@vueform/nuxt",
  "version": "2.0.0-alpha.1",
  "description": "Nuxt module for Vueform.",
  "keywords": [
    "form",
    "forms",
    "nuxt",
    "nuxt-module",
    "vue",
    "vueform"
  ],
  "homepage": "https://github.com/vueform/next",
  "bugs": "https://github.com/vueform/next/issues",
  "license": "MIT",
  "author": "Adam Berecz",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vueform/next.git",
    "directory": "packages/nuxt"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/module.d.mts",
      "import": "./dist/module.mjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "nuxt-module-build build",
    "publint": "publint",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@nuxt/kit": "catalog:",
    "consola": "catalog:",
    "nypm": "catalog:"
  },
  "devDependencies": {
    "@nuxt/module-builder": "catalog:",
    "@nuxt/schema": "catalog:",
    "@vueform/core": "workspace:*",
    "@vueform/primevue": "workspace:*",
    "@vueform/tsconfig": "workspace:*",
    "@vueform/ui": "workspace:*"
  },
  "peerDependencies": {
    "@vueform/primevue": "workspace:*",
    "@vueform/ui": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@vueform/primevue": {
      "optional": true
    },
    "@vueform/ui": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.12.0"
  }
}

{
  "name": "@vueform/primevue",
  "version": "2.0.0-alpha.1",
  "description": "PrimeVue adapter for Vueform — build Vueform forms from PrimeVue components.",
  "keywords": [
    "components",
    "form",
    "forms",
    "primevue",
    "vue",
    "vue3",
    "vueform"
  ],
  "homepage": "https://github.com/vueform/core",
  "bugs": "https://github.com/vueform/core/issues",
  "license": "MIT",
  "author": "Adam Berecz",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vueform/core.git",
    "directory": "packages/primevue"
  },
  "bin": {
    "vueform": "./bin/vueform.mjs"
  },
  "files": [
    "bin",
    "dist",
    "registry"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css",
    "**/*.scss",
    "./dist/components/*/styles.mjs",
    "./dist/vapor/components/*/styles.mjs",
    "./dist/vapor/full.mjs",
    "./dist/full.mjs"
  ],
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/vueform.global.js",
  "jsdelivr": "./dist/vueform.global.js",
  "imports": {
    "#src": "./src/index.ts",
    "#src/*": [
      "./src/*",
      "./src/*.ts",
      "./src/*/index.ts"
    ]
  },
  "exports": {
    ".": {
      "dev": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs"
    },
    "./*.css": {
      "node": "./dist/css/*.css.mjs",
      "default": "./dist/css/*.css"
    },
    "./*.scss": {
      "node": "./dist/scss/*.scss.mjs",
      "default": "./dist/scss/*.scss"
    },
    "./blueprints/*": {
      "dev": "./src/blueprints/*.ts",
      "types": "./dist/blueprints/*.d.ts",
      "import": "./dist/blueprints/*.mjs"
    },
    "./components": {
      "dev": "./src/components/index.ts",
      "types": "./dist/components/index.d.ts",
      "vapor": "./dist/vapor/components/index.mjs",
      "import": "./dist/components/index.mjs"
    },
    "./components/names": {
      "dev": "./src/components/names.ts",
      "types": "./dist/components/names.d.ts"
    },
    "./components/*/raw": {
      "dev": "./src/components/*/index.ts",
      "types": "./dist/components/*/index.d.ts",
      "vapor": "./dist/vapor/components/*/index.mjs",
      "import": "./dist/components/*/index.mjs"
    },
    "./components/*/unstyled": {
      "dev": "./src/components/*/unstyled.ts",
      "types": "./dist/components/*/unstyled.d.ts",
      "vapor": "./dist/vapor/components/*/unstyled.mjs",
      "import": "./dist/components/*/unstyled.mjs"
    },
    "./components/*": {
      "dev": "./src/components/*/styled.ts",
      "types": "./dist/components/*/styled.d.ts",
      "vapor": "./dist/vapor/components/*/styled.mjs",
      "import": "./dist/components/*/styled.mjs"
    },
    "./locales": {
      "dev": "./src/locales/index.ts",
      "types": "./dist/locales/index.d.ts",
      "import": "./dist/locales/index.mjs"
    },
    "./modules": {
      "dev": "./src/modules/modules.ts",
      "types": "./dist/modules/modules.d.ts",
      "import": "./dist/modules/modules.mjs"
    },
    "./rules": {
      "dev": "./src/rules/index.ts",
      "types": "./dist/rules/index.d.ts",
      "import": "./dist/rules/index.mjs"
    },
    "./themes": {
      "dev": "./src/themes/index.ts",
      "types": "./dist/themes/index.d.ts",
      "import": "./dist/themes/index.mjs"
    },
    "./vapor/components": {
      "dev": "./src/components/index.ts",
      "types": "./dist/components/index.d.ts",
      "import": "./dist/vapor/components/index.mjs"
    },
    "./vapor/components/*/raw": {
      "dev": "./src/components/*/index.ts",
      "types": "./dist/components/*/index.d.ts",
      "import": "./dist/vapor/components/*/index.mjs"
    },
    "./vapor/components/*": {
      "dev": "./src/components/*/unstyled.ts",
      "types": "./dist/components/*/unstyled.d.ts",
      "import": "./dist/vapor/components/*/unstyled.mjs"
    },
    "./vapor/full": {
      "dev": "./src/full.ts",
      "types": "./dist/full.d.ts",
      "import": "./dist/vapor/full.mjs"
    },
    "./full": {
      "dev": "./src/full.ts",
      "types": "./dist/full.d.ts",
      "vapor": "./dist/vapor/full.mjs",
      "import": "./dist/full.mjs"
    }
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.mjs"
      },
      "./*.css": {
        "node": "./dist/css/*.css.mjs",
        "default": "./dist/css/*.css"
      },
      "./*.scss": {
        "node": "./dist/scss/*.scss.mjs",
        "default": "./dist/scss/*.scss"
      },
      "./blueprints/*": {
        "types": "./dist/blueprints/*.d.ts",
        "import": "./dist/blueprints/*.mjs"
      },
      "./components": {
        "types": "./dist/components/index.d.ts",
        "vapor": "./dist/vapor/components/index.mjs",
        "import": "./dist/components/index.mjs"
      },
      "./components/names": {
        "types": "./dist/components/names.d.ts"
      },
      "./components/*/raw": {
        "types": "./dist/components/*/index.d.ts",
        "vapor": "./dist/vapor/components/*/index.mjs",
        "import": "./dist/components/*/index.mjs"
      },
      "./components/*/unstyled": {
        "types": "./dist/components/*/unstyled.d.ts",
        "vapor": "./dist/vapor/components/*/unstyled.mjs",
        "import": "./dist/components/*/unstyled.mjs"
      },
      "./components/*": {
        "types": "./dist/components/*/styled.d.ts",
        "vapor": "./dist/vapor/components/*/styled.mjs",
        "import": "./dist/components/*/styled.mjs"
      },
      "./locales": {
        "types": "./dist/locales/index.d.ts",
        "import": "./dist/locales/index.mjs"
      },
      "./modules": {
        "types": "./dist/modules/modules.d.ts",
        "import": "./dist/modules/modules.mjs"
      },
      "./rules": {
        "types": "./dist/rules/index.d.ts",
        "import": "./dist/rules/index.mjs"
      },
      "./themes": {
        "types": "./dist/themes/index.d.ts",
        "import": "./dist/themes/index.mjs"
      },
      "./vapor/components": {
        "types": "./dist/components/index.d.ts",
        "import": "./dist/vapor/components/index.mjs"
      },
      "./vapor/components/*/raw": {
        "types": "./dist/components/*/index.d.ts",
        "import": "./dist/vapor/components/*/index.mjs"
      },
      "./vapor/components/*": {
        "types": "./dist/components/*/unstyled.d.ts",
        "import": "./dist/vapor/components/*/unstyled.mjs"
      },
      "./vapor/full": {
        "types": "./dist/full.d.ts",
        "import": "./dist/vapor/full.mjs"
      },
      "./full": {
        "types": "./dist/full.d.ts",
        "vapor": "./dist/vapor/full.mjs",
        "import": "./dist/full.mjs"
      }
    },
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && vue-tsc -p tsconfig.build.json && tsdown && tsdown -c tsdown.vapor.config.ts",
    "publint": "publint",
    "registry": "vf-registry",
    "size": "vf-size",
    "size:report": "vf-size --report",
    "test": "vitest --project integration --project invariants --maxWorkers=16",
    "test-dts": "vitest run --project test-dts",
    "test-smoke": "vf-smoke",
    "test-smoke-types": "vf-smoke-types",
    "test-visual": "playwright test --config tests/visual/playwright.config.ts",
    "typecheck": "vue-tsc -p tsconfig.app.json --noEmit && vue-tsc -p tsconfig.test.json --noEmit && tsc -p tsconfig.node.json --noEmit"
  },
  "dependencies": {
    "@vueform/cli": "workspace:^",
    "@vueform/core": "workspace:^"
  },
  "devDependencies": {
    "@playwright/test": "catalog:",
    "@primeuix/themes": "catalog:",
    "@primevue/core": "catalog:",
    "@vitejs/plugin-vue": "catalog:",
    "@vue/test-utils": "catalog:",
    "@vueform/tsconfig": "workspace:*",
    "@vueform/utils": "workspace:^",
    "fast-glob": "catalog:",
    "happy-dom": "catalog:",
    "primeicons": "catalog:",
    "primevue": "catalog:",
    "quill": "catalog:",
    "sass-embedded": "catalog:",
    "terser": "catalog:",
    "tsdown": "catalog:",
    "tsx": "catalog:",
    "vue-compiler-sfc-vapor": "catalog:",
    "vue-tsc": "catalog:",
    "vue-vapor": "catalog:"
  },
  "peerDependencies": {
    "primevue": "catalog:peer",
    "vue": "catalog:peer"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "vueform": {
    "group": "adapters",
    "alias": [
      "pv"
    ],
    "playground": {
      "entry": "full",
      "vaporInterop": true,
      "deps": {
        "@primeuix/themes": "^2.0.3",
        "@primevue/core": "^4.5.5",
        "primeicons": "^7.0.0",
        "primevue": "^4.5.5"
      },
      "vaporDeps": {
        "@primeuix/styled": "^0.7.4",
        "quill": "^2.0.3"
      },
      "nuxtDeps": {
        "@primevue/nuxt-module": "^4.5.5"
      }
    },
    "size": {
      "defaultTheme": "theme",
      "envDeps": [
        "primevue",
        "@primeuix/themes",
        "primeicons"
      ]
    }
  }
}

{
  "name": "@vueform/primevue",
  "version": "2.0.0-alpha.1",
  "sideEffects": [
    "**/*.css",
    "**/*.scss",
    "./dist/components/*/styles.mjs",
    "./dist/vapor/components/*/styles.mjs",
    "./dist/vapor/full.mjs",
    "./dist/full.mjs"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs"
    },
    "./*.css": {
      "node": "./dist/css/*.css.mjs",
      "default": "./dist/css/*.css"
    },
    "./*.scss": {
      "node": "./dist/scss/*.scss.mjs",
      "default": "./dist/scss/*.scss"
    },
    "./blueprints/*": {
      "types": "./dist/blueprints/*.d.ts",
      "import": "./dist/blueprints/*.mjs"
    },
    "./components": {
      "types": "./dist/components/index.d.ts",
      "vapor": "./dist/vapor/components/index.mjs",
      "import": "./dist/components/index.mjs"
    },
    "./components/names": {
      "types": "./dist/components/names.d.ts"
    },
    "./components/*/raw": {
      "types": "./dist/components/*/index.d.ts",
      "vapor": "./dist/vapor/components/*/index.mjs",
      "import": "./dist/components/*/index.mjs"
    },
    "./components/*/unstyled": {
      "types": "./dist/components/*/unstyled.d.ts",
      "vapor": "./dist/vapor/components/*/unstyled.mjs",
      "import": "./dist/components/*/unstyled.mjs"
    },
    "./components/*": {
      "types": "./dist/components/*/styled.d.ts",
      "vapor": "./dist/vapor/components/*/styled.mjs",
      "import": "./dist/components/*/styled.mjs"
    },
    "./locales": {
      "types": "./dist/locales/index.d.ts",
      "import": "./dist/locales/index.mjs"
    },
    "./modules": {
      "types": "./dist/modules/modules.d.ts",
      "import": "./dist/modules/modules.mjs"
    },
    "./rules": {
      "types": "./dist/rules/index.d.ts",
      "import": "./dist/rules/index.mjs"
    },
    "./themes": {
      "types": "./dist/themes/index.d.ts",
      "import": "./dist/themes/index.mjs"
    },
    "./vapor/components": {
      "types": "./dist/components/index.d.ts",
      "import": "./dist/vapor/components/index.mjs"
    },
    "./vapor/components/*/raw": {
      "types": "./dist/components/*/index.d.ts",
      "import": "./dist/vapor/components/*/index.mjs"
    },
    "./vapor/components/*": {
      "types": "./dist/components/*/unstyled.d.ts",
      "import": "./dist/vapor/components/*/unstyled.mjs"
    },
    "./vapor/full": {
      "types": "./dist/full.d.ts",
      "import": "./dist/vapor/full.mjs"
    },
    "./full": {
      "types": "./dist/full.d.ts",
      "vapor": "./dist/vapor/full.mjs",
      "import": "./dist/full.mjs"
    }
  },
  "main": "./dist/index.mjs",
  "jsdelivr": "./dist/vueform.global.js",
  "unpkg": "./dist/vueform.global.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "bin": {
    "vueform": "./bin/vueform.mjs"
  },
  "files": [
    "bin",
    "dist",
    "registry"
  ],
  "scripts": {
    "build": "vf-validate-source && vite build",
    "check": "vue-tsc --incremental --noEmit",
    "registry": "vf-registry",
    "size": "vf-size",
    "size:report": "vf-size --report",
    "test": "vitest --project integration --maxWorkers=16",
    "test:dts": "vitest run --project test-dts",
    "test:dts-dist": "vitest run --project test-dts-dist",
    "test:smoke": "tsx tests/smoke/run.ts",
    "test:visual": "playwright test --config tests/visual/playwright.config.ts",
    "validate": "vf-validate-source"
  },
  "dependencies": {
    "@vueform/cli": "workspace:^",
    "@vueform/core": "workspace:^"
  },
  "devDependencies": {
    "@playwright/test": "catalog:",
    "@primeuix/themes": "catalog:",
    "@primevue/core": "catalog:",
    "@vitejs/plugin-vue": "catalog:",
    "@vue/test-utils": "catalog:",
    "@vueform/utils": "workspace:^",
    "fast-glob": "catalog:",
    "happy-dom": "catalog:",
    "primeicons": "catalog:",
    "primevue": "catalog:",
    "quill": "catalog:",
    "sass-embedded": "catalog:",
    "terser": "catalog:",
    "tsx": "catalog:",
    "vite-plugin-dts": "catalog:",
    "vue-compiler-sfc-vapor": "catalog:",
    "vue-vapor": "catalog:"
  },
  "peerDependencies": {
    "primevue": "catalog:peer",
    "vue": "catalog:peer"
  },
  "vueform": {
    "group": "adapters",
    "alias": [
      "pv"
    ],
    "playground": {
      "entry": "full",
      "vaporInterop": true,
      "deps": {
        "@primeuix/themes": "^2.0.3",
        "@primevue/core": "^4.5.5",
        "primeicons": "^7.0.0",
        "primevue": "^4.5.5"
      },
      "vaporDeps": {
        "@primeuix/styled": "^0.7.4",
        "quill": "^2.0.3"
      },
      "nuxtDeps": {
        "@primevue/nuxt-module": "^4.5.5"
      }
    },
    "size": {
      "defaultTheme": "theme",
      "envDeps": [
        "primevue",
        "@primeuix/themes",
        "primeicons"
      ]
    }
  }
}

{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "compilerOptions": {
    "baseUrl": "..",
    "paths": {
      "#shorthands": ["src/types/shorthands.ts"],
      "~/*": ["../core/src/*"],
      "@/*": ["src/*"]
    },
    "types": ["node"]
  },
  "include": ["../src/**/*.ts", "../src/**/*.d.ts", "../src/**/*.vue"]
}

// Package base: repo policy + this package's aliases. Projects with a wider
// alias surface (dev, test, types) redefine `paths` wholesale — TS replaces,
// never merges, that property.
{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "paths": {
      "#shorthands": ["../src/types/shorthands.ts"],
      "~/*": ["../../core/src/*"],
      "@/*": ["../src/*"]
    }
  }
}

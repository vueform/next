// `pnpm tsc:types` — the compile-time contract suite (tests/types).
// NOT YET GATED: ~90 known errors. Root cause is structural — the include
// list omits the core component type files whose SlotProps/registry
// augmentations the program needs (VfLanguages, VfSteps, VfTabs, …), so
// their absence cascades. Fix the include set, burn down, then gate.
{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "paths": {
      "#shorthands": ["../src/types/shorthands.ts"],
      "@vueform/core": ["../../core/src/index.ts"],
      "@vueform/core/blueprints/*": ["../../core/src/blueprints/*"],
      "@vueform/core/components": ["../../core/src/components/index.ts"],
      "@vueform/core/components/*/raw": [
        "../../core/src/components/*/index.ts"
      ],
      "@vueform/core/components/*": ["../../core/src/components/*/unstyled.ts"],
      "@vueform/core/rules": ["../../core/src/rules/index.ts"],
      "@vueform/core/services": ["../../core/src/defaultServices.ts"],
      "@vueform/core/*": ["../../core/src/*"],
      "~/*": ["../../core/src/*"],
      "@/*": ["../src/*"]
    },
    "types": ["node"]
  },
  "include": [
    "../tests/types/**/*.ts",
    "../tests/types/**/*.vue",
    "../src/components/VfSelect/**/*.ts",
    "../src/components/VfSelect/**/*.vue",
    "../src/components/VfAutoComplete/**/*.ts",
    "../src/components/VfAutoComplete/**/*.vue",
    "../src/components/VfCascadeSelect/**/*.ts",
    "../src/components/VfCascadeSelect/**/*.vue",
    "../src/components/VfTreeSelect/**/*.ts",
    "../src/components/VfTreeSelect/**/*.vue",
    "../src/components/VfListbox/**/*.ts",
    "../src/components/VfListbox/**/*.vue",
    "../src/components/VfMultiSelect/**/*.ts",
    "../src/components/VfMultiSelect/**/*.vue",
    "../src/components/VfSelectButton/**/*.ts",
    "../src/components/VfSelectButton/**/*.vue",
    "../src/components/VfCheckboxGroup/**/*.ts",
    "../src/components/VfCheckboxGroup/**/*.vue",
    "../src/components/VfRadioButtonGroup/**/*.ts",
    "../src/components/VfRadioButtonGroup/**/*.vue",
    "../src/components/VfCheckbox/**/*.ts",
    "../src/components/VfCheckbox/**/*.vue",
    "../src/components/VfRadioButton/**/*.ts",
    "../src/components/VfRadioButton/**/*.vue",
    "../src/components/VfLayout/**/*.ts",
    "../src/components/VfLayout/**/*.vue",
    "../src/blueprints/select.ts",
    "../src/blueprints/auto-complete.ts",
    "../src/blueprints/cascade-select.ts",
    "../src/blueprints/tree-select.ts",
    "../src/blueprints/listbox.ts",
    "../src/blueprints/multi-select.ts",
    "../src/blueprints/select-button.ts",
    "../src/blueprints/checkbox-group.ts",
    "../src/blueprints/radio-button-group.ts",
    "../src/features/**/*.ts",
    "../src/types/**/*.ts",
    "../src/utils/**/*.ts",
    "../src/index.ts"
  ]
}

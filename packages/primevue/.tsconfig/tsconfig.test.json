// Editor + reference project for the runtime test suites (src + tests).
// DELIBERATELY UNGUARDED (~23 known errors) — same policy as core's test
// project; see its header.
{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "types": ["node", "vitest/globals"],
    "paths": {
      "#shorthands": ["../src/types/shorthands.ts"],
      "~/*": ["../../core/src/*"],
      "@/*": ["../src/*"],
      "@vueform/primevue": ["../src/index.ts"],
      "@vueform/primevue/full": ["../src/full.ts"],
      "@vueform/primevue/themes": ["../src/themes/index.ts"],
      "@vueform/primevue/tokens": ["../src/themes/tokens.ts"],
      "@vueform/primevue/components": ["../src/components/index.ts"],
      "@vueform/primevue/*": ["../src/*"],
      "@vueform/expr-eval": ["../../expr-eval/src/index.ts"]
    },
    "noImplicitAny": false
  },
  "include": [
    "../src/**/*.ts",
    "../src/**/*.d.ts",
    "../src/**/*.vue",
    "../tests/**/*.ts",
    "../tests/**/*.vue"
  ],
  "exclude": [
    "../tests/types/**/*",
    "../tests/snapshot/**/*",
    "../tests/env/vapor/**/*",
    "../tests/**/vitest.config.ts",
    "../tests/vitest.config.ts"
  ]
}

// Test project — `pnpm tsc:test` (gated in `pnpm check`).
{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "types": ["node", "vitest/globals"]
  },
  "include": ["../src/**/*.ts", "../src/**/*.d.ts", "../src/**/*.vue", "../tests/**/*.ts", "../tests/**/*.vue"],
  "exclude": [
    "../tests/types/**/*",
    "../tests/snapshot/**/*",
    "../tests/env/vapor/**/*",
    "../tests/**/vitest.config.ts",
    "../tests/vitest.config.ts"
  ]
}

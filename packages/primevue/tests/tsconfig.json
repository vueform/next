{
  "extends": "@vueform/tsconfig/base.json",
  "compilerOptions": {
    "types": ["node", "vitest/globals"],
    "paths": {
      "#shorthands": ["../src/types/shorthands.ts"],
      "~/*": ["../../core/src/*"],
      "@/*": ["../src/*"],
      "@vueform/core": ["../../core/src/index.ts"],
      "@vueform/core/blueprints/*": ["../../core/src/blueprints/*.ts"],
      "@vueform/core/components": ["../../core/src/components/index.ts"],
      "@vueform/core/components/*/raw": ["../../core/src/components/*/index.ts"],
      "@vueform/core/components/*": ["../../core/src/components/*/unstyled.ts"],
      "@vueform/core/rules": ["../../core/src/rules/index.ts"],
      "@vueform/core/modules": ["../../core/src/modules/modules.ts"],
      "@vueform/core/locales": ["../../core/src/locales/index.ts"],
      "@vueform/core/tokens": ["../../core/src/tokens/index.ts"],
      "@vueform/core/*": ["../../core/src/*"],
      "@vueform/primevue": ["../src/index.ts"],
      "@vueform/primevue/full": ["../src/full.ts"],
      "@vueform/primevue/rules": ["../src/rules.ts"],
      "@vueform/primevue/modules": ["../src/modules.ts"],
      "@vueform/primevue/locales": ["../src/locales.ts"],
      "@vueform/primevue/themes": ["../src/themes/index.ts"],
      "@vueform/primevue/tokens": ["../src/themes/tokens.ts"],
      "@vueform/primevue/blueprints/*": ["../src/blueprints/*.ts"],
      "@vueform/primevue/components": ["../src/components/index.ts"],
      "@vueform/primevue/components/*/raw": ["../src/components/*/index.ts"],
      "@vueform/primevue/components/*/unstyled": ["../src/components/*/unstyled.ts"],
      "@vueform/primevue/components/*/styles": ["../src/components/*/styles.ts"],
      "@vueform/primevue/components/*": ["../src/components/*/styled.ts"],
      "@vueform/primevue/*": ["../src/*"],
      "@vueform/expr-eval": ["../../expr-eval/src/index.ts"]
    }
  },
  "include": ["../src/**/*.ts", "../src/**/*.d.ts", "../src/**/*.vue", "./**/*.ts", "./**/*.vue"],
  "exclude": ["./types/**/*", "./snapshot/**/*", "./env/vapor/**/*", "./**/vitest.config.ts", "./vitest.config.ts"]
}

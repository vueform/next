{
  "extends": "@vueform/tsconfig/base.json",
  "compilerOptions": {
    "types": ["node"],
    "paths": {
      "vue": ["../../../node_modules/vue-vapor"],
      "@/*": ["../../../src/*"],
      "#shorthands": ["../../../src/types/shorthands.ts"],
      "~/*": ["../../../../core/src/*"],
      "@vueform/core": ["../../../../core/src/index.ts"],
      "@vueform/core/blueprints/*": ["../../../../core/src/blueprints/*.ts"],
      "@vueform/core/components": ["../../../../core/src/components/index.ts"],
      "@vueform/core/components/*/raw": ["../../../../core/src/components/*/index.ts"],
      "@vueform/core/components/*": ["../../../../core/src/components/*/unstyled.ts"],
      "@vueform/core/rules": ["../../../../core/src/rules/index.ts"],
      "@vueform/core/modules": ["../../../../core/src/modules/modules.ts"],
      "@vueform/core/locales": ["../../../../core/src/locales/index.ts"],
      "@vueform/core/tokens": ["../../../../core/src/tokens/index.ts"],
      "@vueform/core/*": ["../../../../core/src/*"]
    }
  },
  "include": ["./**/*.ts", "./**/*.vue"]
}

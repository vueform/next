{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // Declaration-only emission for the tsdown build (see core's twin file
    // for why vue-tsc emits the d.ts). `paths` keeps only the package's own
    // alias: `@vueform/core` then resolves to its BUILT dist types via
    // node_modules — the same types consumers get.
    "declaration": true,
    "emitDeclarationOnly": true,
    "noEmit": false,
    "rootDir": "src",
    "outDir": "dist",
    "paths": {
      "#ui": ["./src/index.ts"],
      "#ui/*": ["./src/*"]
    }
  },
  "include": ["../global.d.ts", "src"]
}

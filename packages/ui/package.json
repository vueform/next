{
  "name": "@vueform/ui",
  "version": "2.0.0-alpha.1",
  "description": "Styled, themeable Vueform UI component layer built on @vueform/core.",
  "keywords": [
    "components",
    "form",
    "forms",
    "theme",
    "ui",
    "vue",
    "vue3",
    "vueform"
  ],
  "homepage": "https://github.com/vueform/next",
  "bugs": "https://github.com/vueform/next/issues",
  "license": "MIT",
  "author": "Adam Berecz",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vueform/next.git",
    "directory": "packages/ui"
  },
  "bin": {
    "vueform": "./bin/vueform.mjs"
  },
  "files": [
    "bin",
    "dist",
    "registry"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css",
    "**/*.scss",
    "./dist/components/*/styles.mjs",
    "./dist/vapor/components/*/styles.mjs",
    "./dist/vapor/origin.mjs",
    "./dist/vapor/material.mjs",
    "./dist/origin.mjs",
    "./dist/material.mjs"
  ],
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/origin.global.js",
  "jsdelivr": "./dist/origin.global.js",
  "imports": {
    "#src": "./src/index.ts",
    "#src/*": [
      "./src/*",
      "./src/*.ts",
      "./src/*/index.ts"
    ]
  },
  "exports": {
    ".": {
      "dev": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs"
    },
    "./*.css": {
      "node": "./dist/css/*.css.mjs",
      "default": "./dist/css/*.css"
    },
    "./*.scss": {
      "node": "./dist/scss/*.scss.mjs",
      "default": "./dist/scss/*.scss"
    },
    "./blueprints/*": {
      "dev": "./src/blueprints/*.ts",
      "types": "./dist/blueprints/*.d.ts",
      "import": "./dist/blueprints/*.mjs"
    },
    "./components": {
      "dev": "./src/components/index.ts",
      "types": "./dist/components/index.d.ts",
      "vapor": "./dist/vapor/components/index.mjs",
      "import": "./dist/components/index.mjs"
    },
    "./components/names": {
      "dev": "./src/components/names.ts",
      "types": "./dist/components/names.d.ts"
    },
    "./components/*/raw": {
      "dev": "./src/components/*/index.ts",
      "types": "./dist/components/*/index.d.ts",
      "vapor": "./dist/vapor/components/*/index.mjs",
      "import": "./dist/components/*/index.mjs"
    },
    "./components/*/unstyled": {
      "dev": "./src/components/*/unstyled.ts",
      "types": "./dist/components/*/unstyled.d.ts",
      "vapor": "./dist/vapor/components/*/unstyled.mjs",
      "import": "./dist/components/*/unstyled.mjs"
    },
    "./components/*": {
      "dev": "./src/components/*/styled.ts",
      "types": "./dist/components/*/styled.d.ts",
      "vapor": "./dist/vapor/components/*/styled.mjs",
      "import": "./dist/components/*/styled.mjs"
    },
    "./locales": {
      "dev": "./src/locales/index.ts",
      "types": "./dist/locales/index.d.ts",
      "import": "./dist/locales/index.mjs"
    },
    "./modules": {
      "dev": "./src/modules/modules.ts",
      "types": "./dist/modules/modules.d.ts",
      "import": "./dist/modules/modules.mjs"
    },
    "./rules": {
      "dev": "./src/rules/index.ts",
      "types": "./dist/rules/index.d.ts",
      "import": "./dist/rules/index.mjs"
    },
    "./themes": {
      "dev": "./src/themes/index.ts",
      "types": "./dist/themes/index.d.ts",
      "import": "./dist/themes/index.mjs"
    },
    "./vapor/components": {
      "dev": "./src/components/index.ts",
      "types": "./dist/components/index.d.ts",
      "import": "./dist/vapor/components/index.mjs"
    },
    "./vapor/components/*/raw": {
      "dev": "./src/components/*/index.ts",
      "types": "./dist/components/*/index.d.ts",
      "import": "./dist/vapor/components/*/index.mjs"
    },
    "./vapor/components/*": {
      "dev": "./src/components/*/unstyled.ts",
      "types": "./dist/components/*/unstyled.d.ts",
      "import": "./dist/vapor/components/*/unstyled.mjs"
    },
    "./vapor/origin": {
      "dev": "./src/origin.ts",
      "types": "./dist/origin.d.ts",
      "import": "./dist/vapor/origin.mjs"
    },
    "./vapor/material": {
      "dev": "./src/material.ts",
      "types": "./dist/material.d.ts",
      "import": "./dist/vapor/material.mjs"
    },
    "./origin": {
      "dev": "./src/origin.ts",
      "types": "./dist/origin.d.ts",
      "vapor": "./dist/vapor/origin.mjs",
      "import": "./dist/origin.mjs"
    },
    "./material": {
      "dev": "./src/material.ts",
      "types": "./dist/material.d.ts",
      "vapor": "./dist/vapor/material.mjs",
      "import": "./dist/material.mjs"
    }
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.mjs"
      },
      "./*.css": {
        "node": "./dist/css/*.css.mjs",
        "default": "./dist/css/*.css"
      },
      "./*.scss": {
        "node": "./dist/scss/*.scss.mjs",
        "default": "./dist/scss/*.scss"
      },
      "./blueprints/*": {
        "types": "./dist/blueprints/*.d.ts",
        "import": "./dist/blueprints/*.mjs"
      },
      "./components": {
        "types": "./dist/components/index.d.ts",
        "vapor": "./dist/vapor/components/index.mjs",
        "import": "./dist/components/index.mjs"
      },
      "./components/names": {
        "types": "./dist/components/names.d.ts"
      },
      "./components/*/raw": {
        "types": "./dist/components/*/index.d.ts",
        "vapor": "./dist/vapor/components/*/index.mjs",
        "import": "./dist/components/*/index.mjs"
      },
      "./components/*/unstyled": {
        "types": "./dist/components/*/unstyled.d.ts",
        "vapor": "./dist/vapor/components/*/unstyled.mjs",
        "import": "./dist/components/*/unstyled.mjs"
      },
      "./components/*": {
        "types": "./dist/components/*/styled.d.ts",
        "vapor": "./dist/vapor/components/*/styled.mjs",
        "import": "./dist/components/*/styled.mjs"
      },
      "./locales": {
        "types": "./dist/locales/index.d.ts",
        "import": "./dist/locales/index.mjs"
      },
      "./modules": {
        "types": "./dist/modules/modules.d.ts",
        "import": "./dist/modules/modules.mjs"
      },
      "./rules": {
        "types": "./dist/rules/index.d.ts",
        "import": "./dist/rules/index.mjs"
      },
      "./themes": {
        "types": "./dist/themes/index.d.ts",
        "import": "./dist/themes/index.mjs"
      },
      "./vapor/components": {
        "types": "./dist/components/index.d.ts",
        "import": "./dist/vapor/components/index.mjs"
      },
      "./vapor/components/*/raw": {
        "types": "./dist/components/*/index.d.ts",
        "import": "./dist/vapor/components/*/index.mjs"
      },
      "./vapor/components/*": {
        "types": "./dist/components/*/unstyled.d.ts",
        "import": "./dist/vapor/components/*/unstyled.mjs"
      },
      "./vapor/origin": {
        "types": "./dist/origin.d.ts",
        "import": "./dist/vapor/origin.mjs"
      },
      "./vapor/material": {
        "types": "./dist/material.d.ts",
        "import": "./dist/vapor/material.mjs"
      },
      "./origin": {
        "types": "./dist/origin.d.ts",
        "vapor": "./dist/vapor/origin.mjs",
        "import": "./dist/origin.mjs"
      },
      "./material": {
        "types": "./dist/material.d.ts",
        "vapor": "./dist/vapor/material.mjs",
        "import": "./dist/material.mjs"
      }
    },
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && vue-tsc -p tsconfig.build.json && tsdown && tsdown -c tsdown.vapor.config.ts",
    "publint": "publint",
    "registry": "vf-registry",
    "size": "vf-size",
    "size:report": "vf-size --report",
    "test": "vitest",
    "test-smoke": "vf-smoke",
    "test-smoke-types": "vf-smoke-types",
    "test-visual": "playwright test --config tests/visual/playwright.config.ts",
    "typecheck": "vue-tsc -p tsconfig.app.json --noEmit && vue-tsc -p tsconfig.test.json --noEmit && tsc -p tsconfig.node.json --noEmit"
  },
  "dependencies": {
    "@vueform/cli": "workspace:^",
    "@vueform/core": "workspace:^"
  },
  "devDependencies": {
    "@playwright/test": "catalog:",
    "@vitejs/plugin-vue": "catalog:",
    "@vueform/tsconfig": "workspace:*",
    "@vueform/utils": "workspace:^",
    "fast-glob": "catalog:",
    "sass-embedded": "catalog:",
    "terser": "catalog:",
    "tsdown": "catalog:",
    "tsx": "catalog:",
    "vue-compiler-sfc-vapor": "catalog:",
    "vue-tsc": "catalog:",
    "vue-vapor": "catalog:"
  },
  "peerDependencies": {
    "vue": "catalog:peer"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "vueform": {
    "group": "adapters",
    "playground": {
      "entry": "origin",
      "head": [
        "<link rel=\"stylesheet\" href=\"https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css\" />"
      ]
    }
  }
}

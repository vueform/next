{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "compilerOptions": {
    "paths": {
      "@vueform/core/blueprints/*": ["../../../packages/core/src/blueprints/*"],
      "@vueform/core/components": ["../../../packages/core/src/components/index.ts"],
      "@vueform/core/components/*/raw": ["../../../packages/core/src/components/*/index.ts"],
      "@vueform/core/components/*": ["../../../packages/core/src/components/*/unstyled.ts"],
      "@vueform/core/rules": ["../../../packages/core/src/rules/index.ts"],
      "@vueform/core/services": ["../../../packages/core/src/defaultServices.ts"],
      "@vueform/core": ["../../../packages/core/src/index.ts"],

      "@vueform/primevue/full": ["../../../packages/primevue/src/full.ts"],
      "@vueform/primevue/rules": ["../../../packages/primevue/src/rules.ts"],
      "@vueform/primevue/services": ["../../../packages/primevue/src/services.ts"],
      "@vueform/primevue/blueprints/*": ["../../../packages/primevue/src/blueprints/*"],
      "@vueform/primevue/components": ["../../../packages/primevue/src/components/index.ts"],
      "@vueform/primevue/components/*": ["../../../packages/primevue/src/components/*/unstyled.ts"],
      "@vueform/primevue": ["../../../packages/primevue/src/index.ts"],
      "~/*": ["../../../packages/core/src/*"],
      "@/*": ["../../../packages/primevue/src/*"]
    },

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,
    "noImplicitAny": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "src/**/*.vue"]
}

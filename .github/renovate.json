{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "schedule": ["before 6am on monday"],
  "timezone": "Europe/Budapest",
  "semanticCommits": "enabled",
  "semanticCommitType": "chore",
  "semanticCommitScope": "deps",
  "rangeStrategy": "bump",
  "automergeType": "branch",
  "labels": ["dependencies"],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 6am on the first day of the month"]
  },
  "packageRules": [
    {
      "description": "One grouped weekly PR for all devDependency patch/minor updates, automerged on green CI",
      "matchDepTypes": ["devDependencies"],
      "matchUpdateTypes": ["patch", "minor"],
      "groupName": "dev dependencies (non-major)",
      "automerge": true
    },
    {
      "description": "Majors get their own PR and wait for review",
      "matchUpdateTypes": ["major"],
      "automerge": false
    },
    {
      "description": "Runtime and peer dependencies always wait for review",
      "matchDepTypes": ["dependencies", "peerDependencies"],
      "automerge": false
    }
  ]
}
